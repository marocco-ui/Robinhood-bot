# Copy to sol-grid/.env and edit. Robinhood API keys live in bots/.env.robinhood.

# paper = simulated orders against real Robinhood prices. live = real money.
TRADING_MODE=paper

GRID_SYMBOL=SOL-USD
GRID_LOWER=60
GRID_UPPER=95
GRID_COUNT=8
GRID_SPACING=geometric

GRID_ORDER_USD=25
GRID_MAX_CAPITAL_USD=150
GRID_MAX_OPEN_BUYS=4
PAPER_STARTING_CASH=500

# Sell the grid's coins and halt if the bid falls this % below GRID_LOWER. 0 = off.
GRID_STOP_LOSS_PCT=10
GRID_CANCEL_ON_EXIT=true
GRID_MIN_SPACING_PCT=3

GRID_TICK_MS=20000
# Robinhood allows ~100 requests/min per account, shared by both bots.
RH_REQUESTS_PER_MINUTE=40

# Optional Telegram alerts (make a NEW token; the old one was exposed)
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
