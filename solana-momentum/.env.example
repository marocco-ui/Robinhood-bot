# Copy to solana-momentum/.env and edit. Robinhood API keys live in bots/.env.robinhood.

# paper = simulated orders against real Robinhood prices. live = real money.
TRADING_MODE=paper

# Money this bot may use (accounting ignores everything else in your account).
MOMENTUM_CAPITAL_USD=300
MOMENTUM_MAX_POSITION_USD=50
MOMENTUM_POSITION_PCT=15
MOMENTUM_MAX_POSITIONS=3

# Exits
MOMENTUM_STOP_LOSS_PCT=-12
MOMENTUM_TAKE_PROFIT_PCT=30
MOMENTUM_TRAIL_ACTIVATE_PCT=12
MOMENTUM_TRAIL_PCT=8
MOMENTUM_MAX_HOLD_HOURS=48
MOMENTUM_COOLDOWN_HOURS=6

# Circuit breakers
MOMENTUM_DAILY_LOSS_PCT=-8
MOMENTUM_PORTFOLIO_STOP_PCT=-30

# Entry filters (see README for what each does)
MOMENTUM_MIN_LIQUIDITY_USD=1000000
MOMENTUM_MIN_VOLUME_ACCEL=1.5
MOMENTUM_MIN_CHANGE_1H_PCT=1
MOMENTUM_MAX_CHANGE_1H_PCT=15
MOMENTUM_MIN_BUY_RATIO=0.55
MOMENTUM_BREAKOUT_LOOKBACK_MIN=60
MOMENTUM_MAX_SPREAD_PCT=3
MOMENTUM_MIN_SCORE=45

# SOL is skipped because the grid bot trades it. Comma-separated.
MOMENTUM_EXCLUDE=SOL

MOMENTUM_SCAN_MS=60000
MOMENTUM_POSITION_MS=15000
RH_REQUESTS_PER_MINUTE=40

# Optional Telegram alerts (make a NEW token; the old one was exposed)
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
