# Copy to stock-trend/.env and edit. Log in first: node shared/scripts/rh-mcp-login.js

# paper = fake money at live Robinhood prices. live = real orders in your Agentic account.
STOCK_MODE=paper
# Required for live mode, so it can't go live by accident.
# STOCK_CONFIRM_LIVE=yes

# Hold STOCK_RISK_SYMBOL while its last month-end close is above its STOCK_SMA_MONTHS-month
# average; otherwise hold STOCK_SAFE_SYMBOL. Tested: SPY / SHY / 10 months (Faber 2007).
STOCK_RISK_SYMBOL=SPY
STOCK_SAFE_SYMBOL=SHY
STOCK_SMA_MONTHS=10

# Most the bot will ever have invested. Extra cash in the account stays as cash.
STOCK_CAPITAL_USD=1000
# Largest single order.
STOCK_MAX_ORDER_USD=1000
# Left uninvested so rounding never overdraws.
STOCK_CASH_RESERVE_USD=1
STOCK_MIN_ORDER_USD=1

# Paper mode starting cash.
STOCK_PAPER_CASH_USD=1000

# How often it checks during market hours (it only trades around month ends or new deposits).
STOCK_POLL_MINUTES=15

# Optional: phone alerts for trades and trend flips.
# TELEGRAM_BOT_TOKEN=
# TELEGRAM_CHAT_ID=
